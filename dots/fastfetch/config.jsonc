{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "kitty-direct",
        "source": "~/.config/hypr/wallpapers/cobra-avatar.png",
        "width": 24,
        "height": 12,
        "padding": { "top": 1, "left": 2, "right": 4 }
    },
    "display": {
        "separator": "  ",
        "color": { "keys": "green", "title": "green" }
    },
    "modules": [
        "title",
        { "type": "custom", "format": "\u001b[38;2;31;54;56m────────────────────" },
        { "type": "os",       "key": "os    ", "keyColor": "green"   },
        { "type": "wm",       "key": "wm    ", "keyColor": "magenta" },
        { "type": "shell",    "key": "shell ", "keyColor": "red"     },
        { "type": "terminal", "key": "term  ", "keyColor": "green"   },
        { "type": "theme",    "key": "theme ", "keyColor": "magenta" },
        { "type": "icons",    "key": "icons ", "keyColor": "red"     },
        { "type": "font",     "key": "font  ", "keyColor": "green"   },
        { "type": "cpu",      "key": "cpu   ", "keyColor": "magenta" },
        { "type": "gpu",      "key": "gpu   ", "keyColor": "red", "format": "{name}" },
        { "type": "memory",   "key": "mem   ", "keyColor": "green"   },
        "break",
        "colors"
    ]
}
